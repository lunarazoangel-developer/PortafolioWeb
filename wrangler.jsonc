{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolioweb",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "CLICK_ANALYTICS",
      "dataset": "click_events"
    }
  ]
}
